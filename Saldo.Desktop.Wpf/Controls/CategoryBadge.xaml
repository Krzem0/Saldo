<UserControl x:Class="Saldo.Desktop.Wpf.Controls.CategoryBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             xmlns:local="clr-namespace:Saldo.Desktop.Wpf.Localization"
             x:Name="Root">
    <UserControl.Resources>
        <local:CategoryIconKindConverter x:Key="IconKind"/>
        <local:CategoryColorBrushConverter x:Key="SoftColor"/>
        <local:TagColorBrushConverter x:Key="SolidColor"/>
        <local:ContrastingTextBrushConverter x:Key="Contrast"/>
    </UserControl.Resources>
    <Border x:Name="BadgeBackground" CornerRadius="12" Padding="4,2,7,2" HorizontalAlignment="Left"
            Background="{Binding ColorCode, ElementName=Root, Converter={StaticResource SoftColor}}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="IconTile" Width="24" Height="24" CornerRadius="5" Margin="0,0,6,0">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource SolidColor}">
                        <Binding Path="ColorCode" ElementName="Root"/>
                        <Binding ElementName="Root" Path="Tag"/>
                    </MultiBinding>
                </Border.Background>
                <icons:PackIconMaterial x:Name="CategoryIcon" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Kind="{Binding IconKey, ElementName=Root, Converter={StaticResource IconKind}}"
                                       Foreground="{Binding Background, ElementName=IconTile, Converter={StaticResource Contrast}}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding NameText, ElementName=Root}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Grid>
    </Border>
</UserControl>
