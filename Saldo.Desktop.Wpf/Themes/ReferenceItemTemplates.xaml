<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Saldo.Desktop.Wpf.Controls"
                    xmlns:entities="clr-namespace:Saldo.Domain.Entities;assembly=Saldo.Domain"
                    xmlns:localization="clr-namespace:Saldo.Desktop.Wpf.Localization">
    <localization:TagColorBrushConverter x:Key="ReferenceColorBrushConverter"/>
    <DataTemplate x:Key="ColoredReferenceItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            <StackPanel x:Name="ColorValue" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ColorSwatch" Width="26" Height="14" CornerRadius="3"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource ReferenceColorBrushConverter}">
                            <Binding Path="ColorCode"/>
                        </MultiBinding>
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding ColorCode}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <TextBlock x:Name="NoColorLabel" Grid.Column="1" Visibility="Collapsed"
                       DataContext="{DynamicResource Localization}" Text="{Binding [ReferenceColorNone]}"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ColorCode}" Value="{x:Null}">
                <Setter TargetName="ColorValue" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="NoColorLabel" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorCode}" Value="">
                <Setter TargetName="ColorValue" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="NoColorLabel" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CategoryReferenceItemTemplate">
        <controls:CategoryBadge NameText="{Binding Name}" ColorCode="{Binding ColorCode}" IconKey="{Binding IconKey}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type entities:Category}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryReferenceItemTemplate}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type entities:Tag}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ColoredReferenceItemTemplate}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type entities:Party}">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type entities:Location}">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
    </DataTemplate>
</ResourceDictionary>
