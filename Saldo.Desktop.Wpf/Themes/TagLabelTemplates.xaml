<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
                    xmlns:localization="clr-namespace:Saldo.Desktop.Wpf.Localization">
    <localization:TagColorBrushConverter x:Key="TagLabelColorBrushConverter"/>
    <localization:ContrastingTextBrushConverter x:Key="TagLabelTextBrushConverter"/>
    <localization:CategoryIconKindConverter x:Key="TagLabelIconKindConverter"/>
    <DataTemplate x:Key="TagLabelTemplate">
        <Border x:Name="TagLabelBorder" CornerRadius="12" Padding="8,3" Margin="0,2,5,2"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <Border.Background>
                <MultiBinding Converter="{StaticResource TagLabelColorBrushConverter}">
                    <Binding Path="ColorCode"/>
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Border.Background>
            <Border.Tag>
                <DynamicResource ResourceKey="ControlBrush"/>
            </Border.Tag>
            <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial x:Name="TagLabelIcon" Kind="{Binding IconKey, Converter={StaticResource TagLabelIconKindConverter}}"
                                       Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{Binding Background, ElementName=TagLabelBorder, Converter={StaticResource TagLabelTextBrushConverter}}"/>
                <TextBlock x:Name="TagLabelText" Text="{Binding Name}" FontSize="11" MaxWidth="120" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                       Foreground="{Binding Background, ElementName=TagLabelBorder, Converter={StaticResource TagLabelTextBrushConverter}}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IconKey, Converter={StaticResource TagLabelIconKindConverter}}" Value="{x:Static icons:PackIconMaterialKind.None}">
                <Setter TargetName="TagLabelIcon" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
