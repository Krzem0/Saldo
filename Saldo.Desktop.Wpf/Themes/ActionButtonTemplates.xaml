<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="AddActionContentTemplate">
        <StackPanel Orientation="Horizontal">
            <Path Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                  Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 7,1 L 7,13 M 1,7 L 13,7"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="EditActionContentTemplate">
        <StackPanel Orientation="Horizontal">
            <Path Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
                  Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                  StrokeThickness="1.4" StrokeLineJoin="Round"
                  Data="M 2,10 L 10,2 L 14,6 L 6,14 L 1,15 Z M 8.5,3.5 L 12.5,7.5 M 2,10 L 6,14"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DeleteActionContentTemplate">
        <StackPanel Orientation="Horizontal">
            <Path Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                  Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                  StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 1,3 L 13,3 M 5,3 L 5,1 L 9,1 L 9,3 M 3,3 L 4,13 L 10,13 L 11,3 M 6,5 L 6,10 M 8,5 L 8,10"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
