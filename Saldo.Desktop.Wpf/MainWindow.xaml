<Window x:Class="Saldo.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Saldo.Desktop.Wpf.Views"
        xmlns:viewModels="clr-namespace:Saldo.Desktop.Wpf.ViewModels"
        Title="{Binding Source={StaticResource Localization}, Path=[AppTitle]}"
        Height="680" Width="1120"
        Background="#F4F6F4"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:TransactionListViewModel}">
            <views:TransactionListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoriesViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PartiesViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LocationsViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <Style x:Key="NavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#28413B"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#E0ECE6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#D6EAE1"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#176B5A"/>
                                <Setter Property="Foreground" Value="#0E4E42"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFDF9" BorderBrush="#DDE5E0" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Source={StaticResource Localization}, Path=[AppTitle]}"
                           FontSize="24" FontWeight="SemiBold" Foreground="#183D35"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="{Binding Source={StaticResource Localization}, Path=[Transaction_AddTitle]}"
                        Command="{Binding TransactionList.AddCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EAF1ED" BorderBrush="#DDE5E0" BorderThickness="0,0,1,0" Padding="12,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Navigation_Main]}"
                                   Foreground="#6B8079" FontSize="11" FontWeight="SemiBold"
                                   Margin="12,0,0,7"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabTransactions]}"
                                     Command="{Binding ShowTransactionsCommand}"
                                     IsChecked="{Binding IsTransactionsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>

                        <Separator Margin="8,18,8,14" Background="#CDDDD6"/>

                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Navigation_ReferenceData]}"
                                   Foreground="#6B8079" FontSize="11" FontWeight="SemiBold"
                                   Margin="12,0,0,7"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabCategories]}"
                                     Command="{Binding ShowCategoriesCommand}"
                                     IsChecked="{Binding IsCategoriesSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabParties]}"
                                     Command="{Binding ShowPartiesCommand}"
                                     IsChecked="{Binding IsPartiesSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabLocations]}"
                                     Command="{Binding ShowLocationsCommand}"
                                     IsChecked="{Binding IsLocationsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="8,0,8,14" Background="#CDDDD6"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[SettingsTitle]}"
                                     Command="{Binding ShowSettingsCommand}"
                                     IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFFDF9" CornerRadius="8" Margin="18,16,18,18" ClipToBounds="True">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
