<Window x:Class="Saldo.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Saldo.Desktop.Wpf.Views"
        xmlns:viewModels="clr-namespace:Saldo.Desktop.Wpf.ViewModels"
        xmlns:backup="clr-namespace:Saldo.Desktop.Wpf.Services"
        xmlns:notifications="clr-namespace:Saldo.Application.Interfaces;assembly=Saldo.Application"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
        Title="{Binding Source={StaticResource Localization}, Path=[AppTitle]}"
        Height="680" Width="1120"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="AutoBackupVisibility"/>
        <DataTemplate DataType="{x:Type viewModels:TransactionTemplatesViewModel}">
            <views:TransactionTemplatesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TransactionListViewModel}">
            <views:TransactionListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoriesViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PartiesViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LocationsViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TagsViewModel}">
            <views:ReferenceListView/>
        </DataTemplate>

        <Style x:Key="NavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <icons:PackIconMaterial Width="18" Height="18" VerticalAlignment="Center"
                                                        Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        IsHitTestVisible="False"/>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Source={StaticResource Localization}, Path=[AppTitle]}"
                           FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>

                <views:AddTransactionButton Grid.Column="2"
                        backup:DatabaseWriteGuard.IsWriteAction="True"
                        DataContext="{Binding TransactionList}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="24,6" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0"
                DataContext="{StaticResource AutomaticBackup}">
            <StackPanel>
              <DockPanel DataContext="{StaticResource Notifications}" Margin="0,2">
                <Button DockPanel.Dock="Left" Content="ⓘ" FontSize="18" Margin="0,0,10,0"
                        Command="{Binding ShowHistoryCommand}" Style="{StaticResource SecondaryActionButtonStyle}"
                        ToolTip="{Binding Source={StaticResource Localization}, Path=[Notifications_Title]}"
                        AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[Notifications_Title]}"/>
                <TextBlock Text="{Binding StatusText}" ToolTip="{Binding Current.Details}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" FontSize="12">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MessageInformationTextBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Current.Severity}" Value="{x:Static notifications:NotificationSeverity.Success}"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Current.Severity}" Value="{x:Static notifications:NotificationSeverity.Warning}"><Setter Property="Foreground" Value="{DynamicResource MessageWarningTextBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Current.Severity}" Value="{x:Static notifications:NotificationSeverity.Error}"><Setter Property="Foreground" Value="{DynamicResource ValidationTextBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style></TextBlock.Style>
                </TextBlock>
              </DockPanel>
              <DockPanel Visibility="{Binding HasError, Converter={StaticResource AutoBackupVisibility}}" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="{Binding Source={StaticResource Localization}, Path=[AutoBackup_Retry]}"
                        Command="{Binding RetryCommand}" Margin="12,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource AutoBackupVisibility}}"/>
                <TextBlock Text="{Binding StatusText}" ToolTip="{Binding BackupPath}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource MessageWarningTextBrush}"/>
              </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,1,0" Padding="12,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Navigation_Main]}"
                                   Foreground="#6B8079" FontSize="11" FontWeight="SemiBold"
                                   Margin="12,0,0,7"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabTransactions]}"
                                     Command="{Binding ShowTransactionsCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.SwapVertical}"
                                     IsChecked="{Binding IsTransactionsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>

                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[Templates], Mode=OneWay}"
                                     Command="{Binding ShowTemplatesCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.FileDocumentMultipleOutline}"
                                     IsChecked="{Binding IsTemplatesSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                        <Separator Margin="8,18,8,14" Background="#CDDDD6"/>

                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Navigation_ReferenceData]}"
                                   Foreground="#6B8079" FontSize="11" FontWeight="SemiBold"
                                   Margin="12,0,0,7"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabCategories]}"
                                     Command="{Binding ShowCategoriesCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.FolderOutline}"
                                     IsChecked="{Binding IsCategoriesSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabParties]}"
                                     Command="{Binding ShowPartiesCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.AccountGroupOutline}"
                                     IsChecked="{Binding IsPartiesSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[TabLocations]}"
                                     Command="{Binding ShowLocationsCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.MapMarkerOutline}"
                                     IsChecked="{Binding IsLocationsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[Tags]}"
                                     Command="{Binding ShowTagsCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.TagOutline}"
                                     IsChecked="{Binding IsTagsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="8,0,8,14" Background="#CDDDD6"/>
                        <RadioButton GroupName="Navigation"
                                     Content="{Binding Source={StaticResource Localization}, Path=[SettingsTitle]}"
                                     Command="{Binding ShowSettingsCommand}"
                                     Tag="{x:Static icons:PackIconMaterialKind.CogOutline}"
                                     IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                     Style="{StaticResource NavigationItemStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="18,16,18,18" ClipToBounds="True">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
