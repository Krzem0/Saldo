<Window x:Class="Saldo.Desktop.Wpf.Views.AccountingPeriodConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding ActionLabel}" Click="Confirm_Click" Style="{StaticResource PrimaryActionButtonStyle}"
                    Padding="16,6" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Cancel]}" IsDefault="True" IsCancel="True"
                    Style="{StaticResource SecondaryActionButtonStyle}" Padding="16,6" MinWidth="80"/>
        </WrapPanel>
    </Grid>
</Window>
