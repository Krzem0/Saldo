<Window x:Class="Saldo.Desktop.Wpf.Views.NotificationHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Saldo.Application.Interfaces;assembly=Saldo.Application"
        Title="{Binding Source={StaticResource Localization}, Path=[Notifications_Title]}"
        Width="720" Height="480" MinWidth="420" MinHeight="260" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Notifications_Hint]}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Notifications_Empty]}"
                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Padding="8,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceBorderBrush}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Timestamp.LocalDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Source={StaticResource Localization}, Path=[Message_Information]}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MessageInformationTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static app:NotificationSeverity.Success}"><Setter Property="Text" Value="{Binding Source={StaticResource Localization}, Path=[Notifications_Success]}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static app:NotificationSeverity.Warning}"><Setter Property="Text" Value="{Binding Source={StaticResource Localization}, Path=[Message_Warning]}"/><Setter Property="Foreground" Value="{DynamicResource MessageWarningTextBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static app:NotificationSeverity.Error}"><Setter Property="Text" Value="{Binding Source={StaticResource Localization}, Path=[Message_Error]}"/><Setter Property="Foreground" Value="{DynamicResource ValidationTextBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Button Grid.Row="2" Content="{Binding Source={StaticResource Localization}, Path=[Close]}" Click="Close_Click"
                HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
    </Grid>
</Window>
