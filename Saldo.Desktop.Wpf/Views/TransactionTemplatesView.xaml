<UserControl x:Class="Saldo.Desktop.Wpf.Views.TransactionTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource SurfaceBrush}"
             xmlns:backup="clr-namespace:Saldo.Desktop.Wpf.Services">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Width="260" Margin="16,0,0,0" Padding="9,5" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                        <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                    </Grid>
                    <TextBox x:Name="TemplateSearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" Padding="0,2,30,2"
                             ToolTip="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Search]}"
                             AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Search]}"/>
                    <Button Grid.Column="1" Command="{Binding ClearSearchCommand}" Click="ClearSearch_Click"
                            ToolTip="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                            AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                            Style="{StaticResource ClearTextButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ValidationTextBrush}" TextWrapping="Wrap"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource ControlBrush}" CornerRadius="6,6,0,0" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="17"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[ReferenceList_Name], Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Source={StaticResource Localization}, Path=[Category], Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Source={StaticResource Localization}, Path=[Type], Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Source={StaticResource Localization}, Path=[Amount], Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="{DynamicResource SurfaceBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryName}"/>
                            <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding AmountLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}"
                           Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" backup:DatabaseWriteGuard.IsWriteAction="True">
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Add], Mode=OneWay}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Edit], Mode=OneWay}" Command="{Binding EditCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Delete], Mode=OneWay}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
