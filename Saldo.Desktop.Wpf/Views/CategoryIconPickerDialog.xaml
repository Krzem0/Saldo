<Window x:Class="Saldo.Desktop.Wpf.Views.CategoryIconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
        Title="{Binding Source={StaticResource Localization}, Path=[IconPicker_Title]}"
        Width="710" Height="620" MinWidth="520" MinHeight="400"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6,36,6" KeyDown="SearchBox_KeyDown"
                     AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[IconPicker_SearchHint]}"
                     ToolTip="{Binding Source={StaticResource Localization}, Path=[IconPicker_SearchHint]}"/>
            <Button Content="×" Command="{Binding ClearSearchCommand}" Click="ClearSearch_Click"
                    Visibility="{Binding CanClearSearch, Converter={StaticResource BoolVisibility}}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="24" Margin="0,0,5,0" Padding="0"
                    FontSize="18" Style="{StaticResource SecondaryActionButtonStyle}"
                    ToolTip="{Binding Source={StaticResource Localization}, Path=[IconPicker_ClearSearch]}"
                    AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[IconPicker_ClearSearch]}"/>
            <Button Grid.Column="1" Command="{Binding SearchCommand}"
                    Content="{Binding Source={StaticResource Localization}, Path=[IconPicker_Search]}"
                    Style="{StaticResource PrimaryActionButtonStyle}" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1">
            <ListBox x:Name="IconsList" ItemsSource="{Binding PageIcons, NotifyOnTargetUpdated=True}" TargetUpdated="Icons_TargetUpdated" SelectedItem="{Binding SelectedIcon}" MouseDoubleClick="Icons_DoubleClick"
                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch" Padding="4">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="96"/><Setter Property="Height" Value="84"/>
                        <Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Tile" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2" CornerRadius="6" Padding="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding DisplayName}">
                            <icons:PackIconMaterial Kind="{Binding Kind}" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,2,0,5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="28" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[IconPicker_Empty]}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ResultCountText}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[IconPicker_Page]}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,5,0"/>
                <TextBox x:Name="PageNumberBox" Text="{Binding PageNumberText, UpdateSourceTrigger=PropertyChanged}"
                         Width="46" Padding="4,3" TextAlignment="Center" VerticalContentAlignment="Center"
                         KeyDown="PageNumberBox_KeyDown" LostKeyboardFocus="PageNumberBox_LostKeyboardFocus"
                         AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[IconPicker_Page]}"
                         ToolTip="{Binding Source={StaticResource Localization}, Path=[IconPicker_PageHint]}"/>
                <TextBlock Text="{Binding PageCountText}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="5,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding PreviousCommand}" Content="{Binding Source={StaticResource Localization}, Path=[IconPicker_Previous]}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="8,0"/>
            <Button Grid.Column="2" Command="{Binding NextCommand}" Content="{Binding Source={StaticResource Localization}, Path=[IconPicker_Next]}" Style="{StaticResource SecondaryActionButtonStyle}"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ChooseButton" IsDefault="True" Content="{Binding Source={StaticResource Localization}, Path=[IconPicker_Choose]}" Click="Choose_Click" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,0">
                <Button.IsEnabled><Binding Path="CanChoose"/></Button.IsEnabled>
            </Button>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Cancel]}" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
