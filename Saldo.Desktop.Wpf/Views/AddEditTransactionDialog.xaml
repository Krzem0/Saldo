<Window x:Class="Saldo.Desktop.Wpf.Views.AddEditTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Saldo.Desktop.Wpf.Controls"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,5"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="Padding" Value="4,3"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,5"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Margin" Value="0,5"/>
            </Style>
            <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B3261E"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="4,-2,0,4"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>

        <!-- Date -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Date]}"/>
        <DatePicker Grid.Row="0" Grid.Column="1"
                    SelectedDate="{Binding Date}"/>

        <!-- Amount -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Amount]}"/>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding AmountError}" Style="{StaticResource FieldErrorStyle}"
                       Visibility="{Binding HasAmountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Counterparty -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Counterparty]}"/>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:AutocompleteComboBox Grid.Column="0" ItemsSource="{Binding Parties}"
                                               SelectedItem="{Binding SelectedCounterparty}"
                                               Text="{Binding CounterpartyText, UpdateSourceTrigger=PropertyChanged}"
                                               DisplayMemberPath="Name"/>
                <Button Grid.Column="1" Content="+" Command="{Binding AddCounterpartyCommand}" Width="28" Margin="6,5,0,5"
                        ToolTip="{Binding Source={StaticResource Localization}, Path=[AddPartyTooltip]}"/>
            </Grid>
            <TextBlock Text="{Binding CounterpartyError}" Style="{StaticResource FieldErrorStyle}"
                       Visibility="{Binding HasCounterpartyError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Description]}"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Category -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Category]}"/>
        <StackPanel Grid.Row="4" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:AutocompleteComboBox Grid.Column="0" ItemsSource="{Binding Categories}"
                                               SelectedItem="{Binding SelectedCategory}"
                                               Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged}"
                                               DisplayMemberPath="Name"/>
                <Button Grid.Column="1" Content="+" Command="{Binding AddCategoryCommand}" Width="28" Margin="6,5,0,5"
                        ToolTip="{Binding Source={StaticResource Localization}, Path=[AddCategoryTooltip]}"/>
            </Grid>
            <TextBlock Text="{Binding CategoryError}" Style="{StaticResource FieldErrorStyle}"
                       Visibility="{Binding HasCategoryError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Location -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Location]}"/>
        <StackPanel Grid.Row="5" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:AutocompleteComboBox Grid.Column="0" ItemsSource="{Binding Locations}"
                                               SelectedItem="{Binding SelectedLocation}"
                                               Text="{Binding LocationText, UpdateSourceTrigger=PropertyChanged}"
                                               DisplayMemberPath="Name"/>
                <Button Grid.Column="1" Content="+" Command="{Binding AddLocationCommand}" Width="28" Margin="6,5,0,5"
                        ToolTip="{Binding Source={StaticResource Localization}, Path=[AddLocationTooltip]}"/>
            </Grid>
            <TextBlock Text="{Binding LocationError}" Style="{StaticResource FieldErrorStyle}"
                       Visibility="{Binding HasLocationError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Type -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Type]}"/>
        <ComboBox Grid.Row="6" Grid.Column="1"
                  ItemsSource="{Binding Types}"
                  SelectedItem="{Binding SelectedType}"
                  DisplayMemberPath="Label"/>

        <!-- Payer -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding Source={StaticResource Localization}, Path=[Payer]}"/>
        <StackPanel Grid.Row="7" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:AutocompleteComboBox Grid.Column="0" ItemsSource="{Binding Parties}"
                                               SelectedItem="{Binding SelectedPayer}"
                                               Text="{Binding PayerText, UpdateSourceTrigger=PropertyChanged}"
                                               DisplayMemberPath="Name"/>
                <Button Grid.Column="1" Content="+" Command="{Binding AddPayerCommand}" Width="28" Margin="6,5,0,5"
                        ToolTip="{Binding Source={StaticResource Localization}, Path=[AddPartyTooltip]}"/>
            </Grid>
            <TextBlock Text="{Binding PayerError}" Style="{StaticResource FieldErrorStyle}"
                       Visibility="{Binding HasPayerError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Errors not associated with a specific field -->
        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="0,8,0,0" Padding="10,8"
                Background="#FFF4F2" BorderBrush="#B3261E" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding HasValidationSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ValidationSummary}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Save]}" Command="{Binding SaveCommand}"
                    Width="80" Padding="0,5" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Cancel]}" Click="Cancel_Click"
                    Width="80" Padding="0,5"/>
        </StackPanel>
    </Grid>
</Window>
