<Window x:Class="Saldo.Desktop.Wpf.Views.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="NameBox" Grid.Row="0" MinWidth="260"
                 Padding="8,5"
                 Text="{Binding EnteredName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Save]}" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}" Padding="16,6" Margin="0,0,8,0" MinWidth="80"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Cancel]}" IsCancel="True"
                    Style="{StaticResource SecondaryActionButtonStyle}" Padding="16,6" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
