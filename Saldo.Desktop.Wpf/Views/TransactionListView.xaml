<UserControl x:Class="Saldo.Desktop.Wpf.Views.TransactionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:Saldo.Desktop.Wpf.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Saldo.Desktop.Wpf.Localization"
             xmlns:domainEnums="clr-namespace:Saldo.Domain.Enums;assembly=Saldo.Domain"
             xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/TagLabelTemplates.xaml"/>
            <ResourceDictionary Source="../Themes/ContextMenuStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <localization:TransactionTypeToTextConverter x:Key="TransactionTypeToTextConverter"/>
        <localization:LocalizedNumberConverter x:Key="LocalizedNumberConverter"/>
        <localization:CategoryColorBrushConverter x:Key="CategoryColorBrushConverter"/>
        <Style x:Key="SummaryFilterButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransactionTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="TransactionGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    <Path x:Name="SortArrow" Grid.Column="1" Width="8" Height="5" Margin="6,0,0,0"
                                          VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"
                                          Stretch="Fill" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" Width="8" HorizontalAlignment="Left" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" Width="8" HorizontalAlignment="Right" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 5 L 4 0 L 8 5 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 5 L 8 0 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransactionGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransactionGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource ActionContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding Source={StaticResource Localization}, Path=[Transaction_Copy]}"
                                  Command="{Binding Tag.AddSimilarCommand}"
                                  CommandParameter="{Binding DataContext}">
                            <MenuItem.Icon>
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                      StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Data="M 5,1 L 13,1 L 13,10 M 1,4 L 10,4 L 10,14 L 1,14 Z"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Month navigation -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&lt;" Command="{Binding PreviousMonthCommand}" Style="{StaticResource MonthNavigationButtonStyle}"/>

            <!-- Clickable month label + picker popup -->
            <Grid Grid.Column="1" HorizontalAlignment="Center">
                <StackPanel>
                    <Button x:Name="MonthPickerButton"
                            Command="{Binding OpenMonthPickerCommand}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Cursor="Hand"
                            Padding="6,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MonthLabel}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12"
                                  Height="6"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding Source={StaticResource Localization}, Path=[CurrentMonth]}"
                            Command="{Binding CurrentMonthCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,3,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       TextDecorations="Underline"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Popup IsOpen="{Binding IsMonthPickerOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=MonthPickerButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <StackPanel Width="220">

                            <!-- Year navigation inside popup -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="‹"
                                        Command="{Binding PreviousPickerYearCommand}"
                                        Padding="8,2" BorderThickness="0"
                                        Background="Transparent" Cursor="Hand"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="18"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding PickerYearText, UpdateSourceTrigger=LostFocus}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Padding="4,2"
                                         Margin="6,0"
                                         Width="90"/>
                                <Button Grid.Column="2" Content="›"
                                        Command="{Binding NextPickerYearCommand}"
                                        Padding="8,2" BorderThickness="0"
                                        Background="Transparent" Cursor="Hand"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="18"/>
                            </Grid>

                            <!-- 4×3 month grid -->
                            <ItemsControl ItemsSource="{Binding PickerMonths}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="4" Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                CommandParameter="{Binding Number}"
                                                Command="{Binding DataContext.SelectMonthCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="2" Padding="4,6" Cursor="Hand" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Button Grid.Column="2" Content="&gt;" Command="{Binding NextMonthCommand}" Style="{StaticResource MonthNavigationButtonStyle}"/>
        </Grid>

        <!-- Summary bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" Padding="6" Margin="8,0,8,6" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel>
                            <Border Padding="7,4" Margin="0,0,6,2" CornerRadius="4"
                                    Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="PeriodStateLabel" Text="{Binding PeriodStateText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Border>
                            <Button x:Name="PeriodActionButton" Content="{Binding PeriodActionText}" Command="{Binding ChangePeriodCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}" Padding="8,4" Margin="0,0,6,2"/>
                            <Button Content="↻" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryActionButtonStyle}"
                                    Padding="6,3" Margin="0,0,0,2" FontSize="16"
                                    ToolTip="{Binding Source={StaticResource Localization}, Path=[AccountingPeriod_Refresh]}"
                                    AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[AccountingPeriod_Refresh]}"/>
                        </WrapPanel>
                        <TextBlock x:Name="PeriodIntegrityLabel" Text="{Binding PeriodIntegrityText}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" x:Name="SummaryButtons" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Background="{DynamicResource SuccessBackgroundBrush}" Style="{StaticResource SummaryFilterButtonStyle}" Command="{Binding ShowIncomeCommand}" Tag="{Binding IsIncomeFilterActive}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Summary_Income]}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedNumberConverter}">
                                    <Binding Path="Summary.TotalIncome"/>
                                    <Binding Source="{StaticResource Localization}" Path="CurrentCulture"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Background="{DynamicResource ExpenseBackgroundBrush}" Style="{StaticResource SummaryFilterButtonStyle}" Command="{Binding ShowExpensesCommand}" Tag="{Binding IsExpenseFilterActive}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Summary_Expense]}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock Foreground="{DynamicResource ExpenseTextBrush}" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedNumberConverter}">
                                    <Binding Path="Summary.TotalExpense"/>
                                    <Binding Source="{StaticResource Localization}" Path="CurrentCulture"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Background="{DynamicResource SummaryBalanceBrush}" Style="{StaticResource SummaryFilterButtonStyle}" Command="{Binding ShowAllCommand}" Tag="{Binding IsAllFilterActive}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Summary_Balance]}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedNumberConverter}">
                                    <Binding Path="Summary.Balance"/>
                                    <Binding Source="{StaticResource Localization}" Path="CurrentCulture"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </Grid>
                <Grid Grid.Column="2" Margin="16,0,0,0">
                <Border Width="260" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" CornerRadius="4"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                            <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                        </Grid>
                        <TextBox x:Name="TransactionSearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" Padding="0,2,30,2"
                                 ToolTip="{Binding Source={StaticResource Localization}, Path=[TransactionList_Search]}"
                                 AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[TransactionList_Search]}"/>
                        <Button Grid.Column="1" Command="{Binding ClearSearchCommand}" Click="ClearSearch_Click"
                                ToolTip="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                                AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                                Style="{StaticResource ClearTextButtonStyle}"/>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Transaction list -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="8,0,8,0"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="TransactionGrid"
                          ItemsSource="{Binding Transactions, NotifyOnTargetUpdated=True}"
                          TargetUpdated="TransactionGrid_TargetUpdated"
                          SelectedItem="{Binding SelectedTransaction}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                          AlternatingRowBackground="{DynamicResource ControlBrush}"
                          Background="Transparent"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource TransactionGridHeaderStyle}"
                          CellStyle="{StaticResource TransactionGridCellStyle}"
                          RowStyle="{StaticResource TransactionGridRowStyle}">
                    <DataGrid.Columns>
                 <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Date]}"
                                    Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                    SortMemberPath="Date"
                                    SortDirection="Descending"
                                    ElementStyle="{StaticResource TransactionTextStyle}"
                                    Width="90" MinWidth="80"/>
                 <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Amount]}"
                                    SortMemberPath="Amount"
                                    Width="110">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource LocalizedNumberConverter}">
                            <Binding Path="Amount"/>
                            <Binding Source="{StaticResource Localization}" Path="CurrentCulture"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TransactionGridCellStyle}">
                            <Setter Property="ToolTip"
                                    Value="{Binding Type, Converter={StaticResource TransactionTypeToTextConverter}}"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}"
                                             Value="{x:Static domainEnums:TransactionType.Expense}">
                                    <Setter Property="Background" Value="{DynamicResource ExpenseBackgroundBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}"
                                             Value="{x:Static domainEnums:TransactionType.Income}">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TransactionTextStyle}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                 <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Category]}" Width="120"
                                         SortMemberPath="CategoryName"
                                         CellStyle="{StaticResource TransactionGridCellStyle}">
                     <DataGridTemplateColumn.CellTemplate>
                         <DataTemplate>
                             <controls:CategoryBadge NameText="{Binding CategoryName}" ColorCode="{Binding CategoryColorCode}" IconKey="{Binding CategoryIconKey}" VerticalAlignment="Center"/>
                         </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                 </DataGridTemplateColumn>
                 <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Description]}" Binding="{Binding Description}"
                                     ElementStyle="{StaticResource TransactionTextStyle}" Width="*" MinWidth="180"/>
                 <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Counterparty]}" Binding="{Binding CounterpartyName}"
                                     ElementStyle="{StaticResource TransactionTextStyle}" Width="160" MinWidth="140"/>
                 <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Payer]}" Binding="{Binding PayerName}"
                                     ElementStyle="{StaticResource TransactionTextStyle}" Width="110"/>
                 <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Location]}" Binding="{Binding Location}"
                                     ElementStyle="{StaticResource TransactionTextStyle}" Width="120"/>
                 <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Tags]}" Width="150" CanUserSort="False">
                     <DataGridTemplateColumn.CellTemplate>
                         <DataTemplate>
                             <ItemsControl ItemsSource="{Binding TagDetails}" ItemTemplate="{StaticResource TagLabelTemplate}" VerticalAlignment="Center">
                                 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                             </ItemsControl>
                         </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                 </DataGridTemplateColumn>
                 <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Actions]}" Width="70" CanUserSort="False" CanUserResize="False">
                     <DataGridTemplateColumn.CellTemplate>
                         <DataTemplate>
                             <Button Command="{Binding DataContext.AddSimilarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                     CommandParameter="{Binding}" Width="30" Height="28" Padding="6"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Style="{StaticResource SecondaryActionButtonStyle}"
                                     ToolTip="{Binding Source={StaticResource Localization}, Path=[Transaction_Copy]}"
                                     ToolTipService.InitialShowDelay="250"
                                     AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[Transaction_Copy]}">
                                 <icons:PackIconMaterial Kind="FileDocumentMultipleOutline" Width="16" Height="16"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                             </Button>
                         </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                 </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TransactionList_Empty]}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=TransactionGrid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Table actions and row count -->
        <Grid Grid.Row="3" Margin="8,6,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource Localization}, Path=[Edit]}" Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="{Binding Source={StaticResource Localization}, Path=[Delete]}" Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerActionButtonStyle}"/>
            </StackPanel>
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}" Mode="OneWay">
                        <Binding Source="{StaticResource Localization}" Path="[TransactionList_RowCount]"/>
                        <Binding ElementName="TransactionGrid" Path="Items.Count"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
