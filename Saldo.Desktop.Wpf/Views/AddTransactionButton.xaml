<UserControl x:Class="Saldo.Desktop.Wpf.Views.AddTransactionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material">
    <UserControl.Resources>
        <Style x:Key="SplitButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryDisabledBrush}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTemplateOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTemplateOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TemplatePickerButton" TargetType="Button" BasedOn="{StaticResource SplitButton}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>0,5,5,0</CornerRadius></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTemplateOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Tag"><Setter.Value><CornerRadius>4</CornerRadius></Setter.Value></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TemplateListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ButtonGroup" DataContext="{Binding TemplatePicker}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="{Binding Source={StaticResource Localization}, Path=[Transaction_AddTitle]}"
                ContentTemplate="{StaticResource AddActionContentTemplate}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SplitButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTemplateOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Command" Value="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsTemplateOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Tag><CornerRadius>5,0,0,5</CornerRadius></Button.Tag>
        </Button>
        <Button Grid.Column="1" Padding="12,9" Command="{Binding OpenTemplatePickerCommand}"
                Style="{StaticResource TemplatePickerButton}"
                ToolTip="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Title]}"
                ToolTipService.InitialShowDelay="250"
                AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Title]}">
            <icons:PackIconMaterial Kind="FileDocumentMultipleOutline" Width="16" Height="16"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Border Grid.Column="1" Width="1" Background="#55FFFFFF" HorizontalAlignment="Left" Margin="0,8" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsTemplateOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers></Style>
            </Border.Style>
        </Border>
        <Popup x:Name="TemplatePopup" IsOpen="{Binding IsTemplatePickerOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=ButtonGroup}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened">
            <Border Width="320" Margin="0,4,0,0" Padding="8" CornerRadius="5"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    DataContext="{Binding PlacementTarget.DataContext, ElementName=TemplatePopup}"
                    PreviewKeyDown="OnPickerKeyDown">
                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Title]}"
                               Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="4,2,4,8"/>
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Search]}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,4,4"/>
                    <Grid Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Text="{Binding TemplateSearch, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6,36,6"
                             ToolTip="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Search]}"
                             AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[TemplatePicker_Search]}"/>
                    <Button Command="{Binding ClearSearchCommand}" Click="ClearSearch_Click" Margin="0,0,5,0"
                            ToolTip="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                            AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                            Style="{StaticResource ClearTextButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{Binding TemplatePickerStatus}" TextWrapping="Wrap" Margin="4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ListBox x:Name="TemplateList" ItemsSource="{Binding FilteredTemplates}"
                             ItemContainerStyle="{StaticResource TemplateListItemStyle}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             MaxHeight="280" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnTemplateClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
