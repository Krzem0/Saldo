<UserControl x:Class="Saldo.Desktop.Wpf.Views.ReferenceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock
                   Text="{Binding Title}"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   FontSize="24"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Width="260" Margin="16,0,0,0" Padding="9,5" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                        <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/>
                    </Grid>
                    <TextBox x:Name="ReferenceSearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" Padding="0,2,30,2"
                             ToolTip="{Binding Source={StaticResource Localization}, Path=[ReferenceList_Search]}"
                             AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[ReferenceList_Search]}"/>
                    <Button Grid.Column="1" Command="{Binding ClearSearchCommand}" Click="ClearSearch_Click"
                            ToolTip="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                            AutomationProperties.Name="{Binding Source={StaticResource Localization}, Path=[ClearText]}"
                            Style="{StaticResource ClearTextButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding Source={x:Static SystemParameters.VerticalScrollBarWidth}}"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[ReferenceList_Name]}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Width="140" Text="{Binding Source={StaticResource Localization}, Path=[ReferenceColor]}"
                                   Visibility="{Binding HasColorColumn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="4">
                        <ListBox.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="../Themes/ReferenceItemTemplates.xaml"/>
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Add]}"    Command="{Binding AddCommand}"    Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Edit]}"   Command="{Binding EditCommand}"   Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Delete]}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
