<UserControl x:Class="Saldo.Desktop.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Saldo.Desktop.Wpf.Localization">
    <UserControl.Resources>
        <Style x:Key="DefaultReferenceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="FieldBorder" CornerRadius="4"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="10,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding ItemTemplate}"
                                                  VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="ClearButton" Grid.Column="1" Content="✕" Width="28" Height="26"
                                        Command="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="{TemplateBinding ToolTip}"
                                        AutomationProperties.Name="{TemplateBinding ToolTip}"
                                        Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}"
                                        BorderThickness="0" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ClearBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ClearBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="ClearBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Path Grid.Column="2" Data="M 0 0 L 6 6 L 12 0 Z"
                                      Fill="{TemplateBinding Foreground}" Width="12" Height="6"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownButton}"
                                   AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTransactionSettingsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Source={StaticResource Localization}, Path=[SettingsTitle]}"
                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1"
                   Text="{Binding Source={StaticResource Localization}, Path=[SettingsDescription]}"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,24"/>

        <Border Grid.Row="2" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="480" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[LanguageLabel]}"
                               Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[SettingsLanguageDescription]}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,12,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Height="32"
                          ItemsSource="{Binding AvailableCultures}"
                          SelectedItem="{Binding CurrentCulture, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NativeName}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="480" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[ThemeLabel]}"
                               Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[ThemeDescription]}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,12,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Height="32"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
        <Border Grid.Row="6" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="480" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[BackupTitle]}"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[BackupDescription]}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button Content="{Binding Source={StaticResource Localization}, Path=[BackupCreate]}"
                            Command="{Binding CreateBackupCommand}" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,7"/>
                    <Button Content="{Binding Source={StaticResource Localization}, Path=[OpenDatabaseFolder]}"
                            Command="{Binding OpenDatabaseFolderCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,7"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="8" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="20" Width="480" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TransactionSettingsTitle]}"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[DefaultPayerDescription]}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[DefaultPayerLabel]}"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DefaultPayerOptions}"
                          SelectedItem="{Binding SelectedDefaultPayerOption, Mode=TwoWay}" Height="32"
                          Style="{StaticResource DefaultReferenceComboBoxStyle}" Tag="{Binding ClearDefaultPayerCommand}"
                          ToolTip="{Binding Source={StaticResource Localization}, Path=[ClearDefaultPayer]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[DefaultLocationDescription]}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,16,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[DefaultLocationLabel]}"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DefaultLocationOptions}"
                          SelectedItem="{Binding SelectedDefaultLocationOption, Mode=TwoWay}" Height="32"
                          Style="{StaticResource DefaultReferenceComboBoxStyle}" Tag="{Binding ClearDefaultLocationCommand}"
                          ToolTip="{Binding Source={StaticResource Localization}, Path=[ClearDefaultLocation]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
                <TextBlock Text="{Binding TransactionSettingsMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
