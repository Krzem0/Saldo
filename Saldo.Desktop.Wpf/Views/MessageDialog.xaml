<Window x:Class="Saldo.Desktop.Wpf.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{Binding Source={StaticResource Localization}, Path=[Close]}"
                IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="80" Padding="16,6"
                Style="{StaticResource PrimaryActionButtonStyle}"/>
    </Grid>
</Window>
