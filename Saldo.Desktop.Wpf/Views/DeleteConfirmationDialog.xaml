<Window x:Class="Saldo.Desktop.Wpf.Views.DeleteConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Message}"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   FontSize="14"
                   TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Delete]}"
                    Click="Delete_Click"
                    Style="{StaticResource DangerActionButtonStyle}"
                    Padding="16,6"
                    MinWidth="80"
                    Margin="0,0,8,0"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Cancel]}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Padding="16,6"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
