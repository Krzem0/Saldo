# Store text files normalized in the repository and use Windows line endings
# in the working tree. Git keeps the index representation as LF by design.
* text=auto eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab

# Common source and project files are explicitly text files.
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.resx text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Binary files must never be passed through text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.db binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.pdf binary
